# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Database Configuration (Coolify PostgreSQL format)
# Replace YOUR_DB_PASSWORD and YOUR_DB_SERVICE_NAME with actual values from Coolify
DATABASE_URL="postgres://postgres:YOUR_DB_PASSWORD@YOUR_DB_SERVICE_NAME:5432/postgres"

# Admin Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_admin_password"

# Email Configuration (SendGrid recommended)
MAIL_HOST="smtp.sendgrid.net"
MAIL_USERNAME="apikey"
MAIL_PASSWORD="YOUR_SENDGRID_API_KEY"
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="your-email@yourdomain.com"
TO_EMAIL="recipient@yourdomain.com"

# Security
renewPassword="your_master_renew_password"
JWT_SECRET="your-very-strong-secret-key-min-32-characters"
# Scheduler for /api/cron/check-services must send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET="another-long-random-secret"

# AI assistant (MCP) — public URL of this app, used in OAuth metadata and token audience
APP_URL="https://lisans.yourdomain.com"
# Optional: hosts allowed as OAuth redirect targets (default: chatgpt.com, chat.openai.com, claude.ai, claude.com).
# Add "localhost" to test with MCP Inspector.
# MCP_REDIRECT_HOSTS="chatgpt.com,claude.ai"

# Next.js Configuration
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1
PORT=3000
